<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news_scrollable = false %}
    {% if include.limit and site.announcements.scrollable and news_size > 6 %}
      {% assign news_scrollable = true %}
    {% endif %}
    <div
      class="table-responsive"
      {% if news_scrollable %}
        id="news-scroll" style="max-height: 22rem; overflow-y: auto"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and site.announcements.limit %}
          {% assign news_limit = site.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if news_scrollable %}
      <script>
        // Size the news box to show exactly the first 6 items, then scroll.
        (function () {
          function fitNews() {
            var box = document.getElementById('news-scroll');
            if (!box) return;
            var rows = box.querySelectorAll('tr');
            if (rows.length <= 6) return;
            var height = rows[6].getBoundingClientRect().top - box.getBoundingClientRect().top + box.scrollTop;
            box.style.maxHeight = height + 'px';
          }
          document.addEventListener('DOMContentLoaded', fitNews);
          window.addEventListener('load', fitNews);
          window.addEventListener('resize', fitNews);
        })();
      </script>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
