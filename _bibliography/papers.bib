@inproceedings{nguyen2022feddrl,
  abbr={ICPP},
  title={Feddrl: Deep reinforcement learning-based adaptive aggregation for non-iid data in federated learning},
  author={Nguyen, Nang Hung and Nguyen, Phi Le and Nguyen, Thuy Dung and Nguyen, Trung Thanh and Nguyen, Duc Long and Nguyen, Thanh Hung and Pham, Huy Hieu and Truong, Thao Nguyen},
  booktitle={Proceedings of the 51st International Conference on Parallel Processing},
  pages={1--11},
  year={2022},
  abstract={To deal with non-IID data, particularly the cluster-skewed data, we propose FedDRL, a novel FL model that employs deep reinforcement learning to adaptively determine each client's impact factor (which will be used as the weights in the aggregation process). Extensive experiments on a suite of federated datasets confirm that the proposed FedDRL improves favorably against FedAvg and FedProx methods, e.g., up to 4.05% and 2.17% on average for the CIFAR-100 dataset, respectively.},
  pdf={https://dl.acm.org/doi/10.1145/3545008.3545085},

}

@article{nguyen2021joint,
  abbr={JOLOT},
  title={Joint optimization of charging location and time for network lifetime extension in WRSNs},
  author={Nguyen, Thuy Dung and Nguyen, Tuyen and Nguyen, Thanh Hung and Nguyen, Kien and Le Nguyen, Phi},
  journal={IEEE Transactions on Green Communications and Networking},
  volume={6},
  number={2},
  pages={1186--1197},
  year={2021},
  selected={true},
  publisher={IEEE},
  abstract={Wireless rechargeable sensor networks (WRSNs)
have emerged as a potential solution to solve the challenge of prolonging battery-powered sensor networks’ lifetime. In a WRSN,
a mobile charger moves around and charges the rechargeable
sensors when stopping at charging spots. This paper newly considers a joint optimization of the charging location and the
charging time to avoid node failure in WRSNs. We formulate
the optimization and propose a solution for that. The proposal
includes an algorithm to find a list of potential charging locations and their associated optimal charging time. Moreover, the
Q-learning technique is adopted to determine the optimal next
charging location among the candidates. We implement the algorithm and conduct experiments to compare it to the related
works. The results show that the proposed algorithm outperforms the others in terms of network lifetime. Specifically, the
highest performance gap of our proposal to the best algorithm
among the others is 8.29 times.},
  pdf={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=9590561},
}

@article{nguyen2024backdoor,
  abbr={EAAI},
  title={Backdoor attacks and defenses in federated learning: Survey, challenges and future research directions},
  author={Nguyen, Thuy Dung and Nguyen, Tuan and Le Nguyen, Phi and Pham, Hieu H and Doan, Khoa D and Wong, Kok-Seng},
  journal={Engineering Applications of Artificial Intelligence},
  volume={127},
  pages={107166},
  year={2024},
  selected={true},
  publisher={Elsevier},
  pdf={https://www.sciencedirect.com/science/article/pii/S0952197623013507},
  abstract={Federated learning (FL) has emerged as a promising paradigm for training machine learning models on decentralized data. However, FL is vulnerable to backdoor attacks, where a malicious client injects a backdoor pattern into its local data to manipulate the global model. This paper provides a comprehensive survey of backdoor attacks and defenses in FL. We first introduce the background of FL and backdoor attacks, followed by a detailed review of existing backdoor attacks and defenses in FL. We then discuss the challenges and future research directions in this area. Finally, we provide a summary of the surveyed works and suggest potential research directions for future studies.}
}

@inproceedings{nguyen2022image,
  title={Image-based contextual pill recognition with medical knowledge graph assistance},
  author={Nguyen, Anh Duy and Nguyen, Thuy Dung and Pham, Huy Hieu and Nguyen, Thanh Hung and Nguyen, Phi Le},
  booktitle={Asian Conference on Intelligent Information and Database Systems},
  pages={354--369},
  year={2022},
  abbr={ACIIDS},
  organization={Springer},
  abstract={The first study to use external prescription data to establish associations between medicines and to classify them using this aiding information. The architecture of PIKA is lightweight and has the flexibility to incorporate into any recognition backbones. The experimental results show that by leveraging the external knowledge graph, PIKA can improve the recognition accuracy from 
  4.8 % to 31.1% in terms of F1-score, compared to baselines.},
  pdf={https://link.springer.com/chapter/10.1007/978-981-19-8234-7_28}
}

@article{nguyen2024iba,
  abbr={NeurIPS},
  title={Iba: Towards irreversible backdoor attacks in federated learning},
  author={Nguyen, Thuy Dung and Nguyen, Tuan A and Tran, Anh and Doan, Khoa D and Wong, Kok-Seng},
  journal={Advances in Neural Information Processing Systems},
  volume={36},
  year={2024},
  selected={true},
  abstract={We propose a novel backdoor attack framework in FL, the Irreversible Backdoor Attack (IBA), that jointly learns the optimal and visually stealthy trigger and then gradually implants the backdoor into a global model. This approach allows the adversary to execute a backdoor attack that can evade both human and machine inspections. Additionally, we enhance the efficiency and durability of the proposed attack by selectively poisoning the model's parameters that are least likely updated by the main task's learning process and constraining the poisoned model update to the vicinity of the global model. },
  pdf={https://proceedings.neurips.cc/paper_files/paper/2023/file/d0c6bc641a56bebee9d985b937307367-Paper-Conference.pdf},
  code={https://github.com/sail-research/iba}
}

@article{nguyen2023attentional,
  title={Attentional ensemble model for accurate discharge and water level prediction with training data enhancement},
  author={Nguyen, Anh Duy and Vu, Viet Hung and Hoang, Duc Viet and Nguyen, Thuy Dung and Nguyen, Kien and Le Nguyen, Phi and Ji, Yusheng},
  journal={Engineering Applications of Artificial Intelligence},
  volume={126},
  pages={107073},
  abbr={EAAI},
  year={2023},
  publisher={Elsevier},
  abstract={This research introduces a novel deep learning-based method for forecasting discharge and water levels, addressing challenges like data scarcity, noise, and underestimation. The approach combines 1D-CNN for feature extraction, LSTM for capturing temporal relationships, ensemble learning for enhanced predictive performance, and Singular-Spectrum Analysis (SSA) to reduce noise. Leveraging an attention mechanism and Linear Exponential (LINEX) loss, the method achieves significant improvements, including up to 40% and 34% gains in the Nash–Sutcliffe Efficiency coefficient for one-step-ahead and multistep-ahead predictions, respectively, compared to existing approaches.},
  pdf={https://www.sciencedirect.com/science/article/pii/S0952197623012575}
}

@article{nguyen2024gamma,
  title={GAMMA: A universal model for calibrating sensory data of multiple low-cost air monitoring devices},
  author={Nguyen, Anh Duy and Phung, Thu Hang and Nguyen, Thuy Dung and Pham, Huy Hieu and Nguyen, Kien and Le Nguyen, Phi},
  journal={Engineering Applications of Artificial Intelligence},
  volume={128},
  pages={107591},
  year={2024},
  publisher={Elsevier},
  pdf={https://www.sciencedirect.com/science/article/pii/S095219762301775X},
  abstract={This study introduces GAMMA, a deep learning-based approach for calibrating data from low-cost air quality monitoring devices, addressing accuracy limitations and the need for device-specific calibration. By leveraging multitask learning to capture shared and device-specific features and employing adversarial training, GAMMA simultaneously calibrates data for multiple devices with improved precision. Implemented in Hanoi, Vietnam, GAMMA demonstrates superior performance, reducing MAE by 60.19% to 74.09% compared to the best baseline.}
}

@article{nguyen2024pbp,
  title={PBP: Post-training Backdoor Purification for Malware Classifiers},
  author={Nguyen, Dung Thuy and Tran, Ngoc N and Johnson, Taylor T and Leach, Kevin},
  journal={Network and Distributed System Security Symposium (NDSS)},
  year={2025},
  pdf={https://arxiv.org/abs/2412.03441},
  abstract={This research introduces PBP, a post-training defense for malware classifiers to mitigate backdoor poisoning attacks without relying on specific embedding mechanisms. By regulating batch normalization statistics to correct activation distribution distortions caused by backdoors, PBP effectively restores model performance to a clean state. Experiments show that PBP reduces attack success rates from 100% to nearly 0% using just 1% of training data, significantly outperforming state-of-the-art methods.},
  abbr={NDSS},
  selected={true},
  preview={brownian-motion.gif},
  image={https://www.ndss-symposium.org/wp-content/uploads/2021/09/ndss2022-logo.png}
}

